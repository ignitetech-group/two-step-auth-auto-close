{
	"manifest_version": 3,
	"name": "Two-step Auth Auto-Close",
	"version": "0.5",
	"description": "Automatically closes Kerio VPN and AWS/local auth callback tabs after successful authentication.",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		},
		"default_title": "Two-step Auth Auto-Close"
	},
	"permissions": ["alarms", "scripting", "tabs"],
	"host_permissions": [
		"http://keriovpn.devfactory.local/*",
		"http://10.212.255.245/*",
		"http://localhost/*",
		"http://127.0.0.1/*"
	],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"http://keriovpn.devfactory.local/*",
				"http://10.212.255.245/*",
				"http://localhost/*",
				"http://127.0.0.1/*"
			],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	]
}
